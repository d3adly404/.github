# ─────────────────────────────────────────────────────────────
# GhanaBed — environment configuration
# Copy to `.env.local` and adjust. Everything has a safe default,
# so the app runs with NO environment variables set (simulator mode).
# ─────────────────────────────────────────────────────────────

# --- App ---
NODE_ENV=development
PORT=3000
# Public origin used when building deep links inside notifications
APP_BASE_URL=http://localhost:3000
# Secret used to sign session cookies (CHANGE IN PRODUCTION)
APP_SECRET=change-me-in-production-please-use-a-long-random-string

# --- Database ---
# SQLite file, created + seeded automatically on first boot
DB_PATH=./data/bedtracker.sqlite
# Reset + re-seed the database whenever it is empty (true) or on every boot (force)
DB_SEED=true

# --- Live occupancy simulator (demo data churn) ---
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=25

# --- Notification delivery ---
# simulator = render + store every message locally (no outbound calls)
# live      = deliver through the providers configured below
NOTIFY_MODE=simulator
NOTIFY_FROM_NAME=GhanaBed
NOTIFY_SENDER_ID=GHANABED

# Hubtel SMS  (https://hubtel.com)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER=GhanaBed

# Arkesel SMS (https://arkesel.com) — used as SMS fallback
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=GhanaBed

# SMTP e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GhanaBed <no-reply@ghanabed.health>"

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_BED_FREED=
WHATSAPP_TEMPLATE_FACILITY_FULL=

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@ghanabed.health
